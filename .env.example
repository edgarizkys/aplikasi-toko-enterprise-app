# Database
DATABASE_URL=postgresql://user:password@localhost:5432/toko_enterprise_db

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Aplikasi Toko Enterprise
NEXT_PUBLIC_BRAND_COLOR_PRIMARY=#0EA5E9
NEXT_PUBLIC_BRAND_COLOR_SECONDARY=#6366F1

# Encryption
ENCRYPTION_KEY=your_encryption_key_min_32_chars_for_sensitive_data

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,csv,xlsx

# Cache
REDIS_URL=redis://localhost:6379

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@tokosarah.com

# Payment Gateway (Optional)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_ENVIRONMENT=sandbox

# SMS/WhatsApp (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Barcode/QR Code
BARCODE_PREFIX=TOKO
BARCODE_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000

# Analytics (Optional)
MIXPANEL_TOKEN=your_mixpanel_token
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Session
SESSION_SECRET=your_session_secret_min_32_chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
FEATURE_CUSTOMER_POINTS=true
FEATURE_BARCODE_ENABLED=true
FEATURE_SALES_REPORT=true
FEATURE_MULTI_BRANCH=false
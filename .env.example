I'll generate the `.env.example` file for the Aplikasi Toko Enterprise application with all necessary environment variables for a production-ready setup.

```
# ============================================
# APLIKASI TOKO ENTERPRISE - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Aplikasi Toko Enterprise
APP_PORT=3000
APP_HOST=localhost
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# ============================================
# DATABASE - Turso SQLite
# ============================================
DATABASE_URL=libsql://your-database-slug.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token_here
DATABASE_SYNC_INTERVAL=30000
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=5000

# Local SQLite fallback (development)
DATABASE_LOCAL_PATH=./data/enterprise_store.db
DATABASE_LOCAL_ENABLED=true

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
SESSION_SECRET=your_session_secret_key_here
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================
# MULTI-TENANT CONFIGURATION
# ============================================
MULTI_TENANT_ENABLED=true
TENANT_ISOLATION_STRATEGY=database
DEFAULT_TENANT_ID=default
TENANT_DOMAIN_PATTERN=*.enterprise-store.local

# ============================================
# PAGINATION & PERFORMANCE
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
CACHE_ENABLED=true
CACHE_TTL=3600000
ENABLE_QUERY_LOGGING=false

# ============================================
# CURRENCY & LOCALIZATION
# ============================================
DEFAULT_CURRENCY=IDR
SUPPORTED_CURRENCIES=IDR,USD,SGD,MYR
DEFAULT_LANGUAGE=id
DATE_FORMAT=DD/MM/YYYY
NUMBER_FORMAT=en-US

# ============================================
# TAX CONFIGURATION
# ============================================
DEFAULT_TAX_RATE=0.10
TAX_ENABLED=true
TAX_ROUNDING_METHOD=round
DISCOUNT_ENABLED=true

# ============================================
# INVENTORY & STOCK MANAGEMENT
# ============================================
STOCK_ALERT_ENABLED=true
STOCK_ALERT_EMAIL=alerts@enterprise-store.com
LOW_STOCK_THRESHOLD=10
REORDER_AUTO_ENABLED=false
INVENTORY_SYNC_INTERVAL=60000

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@enterprise-store.com
EMAIL_FROM_NAME=Aplikasi Toko Enterprise
EMAIL_TEMPLATES_PATH=./templates/emails
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================
# SMS & NOTIFICATION SERVICES
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=your_whatsapp_api_key

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================
PAYMENT_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_ENVIRONMENT=sandbox

# Alternative: Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Bank Transfer & Virtual Account
BANK_TRANSFER_ENABLED=true
VIRTUAL_ACCOUNT_PROVIDER=bca,mandiri,bni
AUTO_CONFIRM_PAYMENT=false
PAYMENT_TIMEOUT=24h

# ============================================
# STORAGE CONFIGURATION
# ============================================
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xlsx,csv

# AWS S3 Alternative
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=enterprise-store-uploads
AWS_S3_URL=https://s3.amazonaws.com

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true

# ============================================
# ANALYTICS & REPORTING
# ============================================
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=internal
REPORT_GENERATION_SCHEDULE=0 0 * * *
REPORT_RETENTION_DAYS=365

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ============================================
# CREDIT LIMIT & CUSTOMER MANAGEMENT
# ============================================
DEFAULT_CREDIT_LIMIT=0
AUTO_CREDIT_APPROVAL=false
CREDIT_REVIEW_DAYS=30
OVERDUE_PAYMENT_GRACE_DAYS=5
SEND_OVERDUE_REMINDER=true
OVERDUE_REMINDER_INTERVAL=7

# ============================================
# PURCHASE ORDER & SUPPLIER MANAGEMENT
# ============================================
AUTO_GENERATE_PO=false
PO_APPROVAL_REQUIRED=true
SUPPLIER_RATING_ENABLED=true
MINIMUM_SUPPLIER_RATING=3.0

# ============================================
# DOCUMENT GENERATION
# ============================================
PDF_ENGINE=pdfkit
GENERATE_INVOICE_PDF=true
GENERATE_PO_PDF=true
GENERATE_RECEIPT_PDF=true
PDF_OUTPUT_PATH=./documents
ENABLE_DIGITAL_SIGNATURE=false

# ============================================
# RATE LIMITING & SECURITY
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_HELMET=true
ENABLE_HPP=true
ENABLE_MONGO_SANITIZE=true

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
BACKUP_COMPRESSION=true

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================
INTEGRATION_SLACK=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

INTEGRATION_ZAPIER=false
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/

# ============================================
# DEVELOPMENT & DEBUGGING
# ============================================
DEBUG=false
DEBUG_SQL=false
SEED_DATABASE=false
SEED_SAMPLE_DATA=true
API_DOCUMENTATION_ENABLED=true
SWAGGER_ENABLED=true

# ============================================
# PERFORMANCE TUNING
# ============================================
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_CACHING=true
CACHE_STRATEGY=memory
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_MULTI_CURRENCY=true
FEATURE_MULTI_TENANT=true
FEATURE_AUDIT_LOG=true
FEATURE_CREDIT_MANAGEMENT=true
FEATURE_INVENTORY_SYNC=true
FEATURE_AUTO_INVOICE=true
FEATURE_PAYMENT_GATEWAY=true
FEATURE_STOCK_ALERTS=true